# ── Transcript Formatting ─────────────────────────────────────────────────────
WPM=150            # Words per minute (used to estimate segment duration)
GAP_SEC=1           # Silence gap between segments in transcript (seconds)

# ── TTS Generation ────────────────────────────────────────────────────────────
GAP_MS=1000         # Silence gap between TTS segments (milliseconds)
TTS_VOICE=af_sky    # Kokoro voice ID
TTS_SPEED=1.1       # TTS playback speed (0.5 – 2.0)
TTS_LANG=en-us      # Language code

# ── Kokoro Model Files ────────────────────────────────────────────────────────
# Download from: https://github.com/thewh1teagle/kokoro-onnx/releases
KOKORO_MODEL=kokoro-v0_19.onnx
VOICES_BIN=voices.bin

# ── File Paths ────────────────────────────────────────────────────────────────
RAW_TRANSCRIPT=raw_transcript.txt
TRANSCRIPT=transcript.txt
SEGMENTS_DIR=segments
FINAL_AUDIO=final_audio.mp3
OUTPUT_VIDEO=output.mp4

# ── Input Video ───────────────────────────────────────────────────────────────
VIDEO_FILE=Recording.mp4

# ── Audio/Video Encoding ──────────────────────────────────────────────────────
AUDIO_BITRATE=128k
SAMPLE_RATE=48000
VIDEO_PRESET=medium   # fast | medium | slow
VIDEO_CRF=23          # 0–51, lower = higher quality (23 = default)
